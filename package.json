{
  "name": "infinite-vrcraft",
  "version": "1.0.0",
  "description": "Infinite Craft Ultimate — jeu de fusion d'elements jouable dans le navigateur, sans compte, avec 3 sauvegardes, quetes, mondes et familiers.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "scripts": {
    "start": "node tools/serve.mjs",
    "serve": "node tools/serve.mjs",
    "build": "node tools/build-registry.mjs",
    "validate": "node tools/validate-registry.mjs",
    "generate": "node tools/generate-recipes.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:modules": "node tools/check-modules.mjs",
    "check:selectors": "node tools/check-selectors.mjs",
    "check:smoke": "node tools/smoke-dom.mjs",
    "check": "npm run check:modules && npm run check:selectors && npm run check:smoke && npm run validate"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "game",
    "craft",
    "fusion",
    "css",
    "javascript",
    "github-pages"
  ]
}
